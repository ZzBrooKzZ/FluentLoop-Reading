# GEMINI_API_KEY: Server-side API key used exclusively for POST /api/grade-answers
# to evaluate unmatched open-ended comprehension answers.
# Never expose this key in client-side code or VITE_ variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_GRADING_MODEL: Configurable low-cost Gemini model for semantic answer grading.
# Defaults to gemini-3.8-flash if unset.
GEMINI_GRADING_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
